<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.vnahodil.financeradar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>/Users/vnahodil/dev/finance_hunt/run_daily.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/vnahodil/dev/finance_hunt</string>

    <!-- Scheduled Time: 08:00 AM every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/vnahodil/dev/finance_hunt/launchd_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/vnahodil/dev/finance_hunt/launchd_stderr.log</string>
</dict>
</plist>
